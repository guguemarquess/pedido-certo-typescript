{
  "name": "pedido-certo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de pedidos em TypeScript: modelagem de dados e regras de negócio pelo sistema de tipos.",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/main.js",
    "legado": "node legado/pedidos.js",
    "demo:sem-source-map": "tsc && node dist/demo-source-map.js",
    "demo:com-source-map": "tsc && node --enable-source-maps dist/demo-source-map.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
